uvchecker_mtl = Standard()
uvchecker_mtl.name = "uvchecker_mat"
mappath = pathConfig.GetDir #maxroot + "maps\\uvwunwrap\\UV_Checker.png"
uvchecker_mtl.diffuseMap = Bitmaptexture fileName:mappath
showTextureMap uvchecker_mtl true
uvchecker_mtl.selfIllumAmount = 100

nitrousgraphicsmanager.OverrideShadingMtl = uvchecker_mtl
