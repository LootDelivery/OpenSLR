/*
  This script should be loaded from the following location : /3dsMax/scripts/startup/
  
  The purpose of this script is to remove then reinitialize the Civil View menu every time 3ds Max starts.
  
  This script is vital in scenarios where the optional Civil View component is uninstalled which would leave 
  a defunct fully populated Civil View menu in place.  
  
  This script is called during the 3ds Max startup sequence in the following order:
   - after the pre-load script "/stdscripts/CivilViewIO/CivilView.Plugins.ms" is loaded.
   - after the 3ds Max user interface is loaded
   - before the post-load script "/Component/Package/Contents/CivilView.Startup.ms" is loaded which will make further changes to the Civil View menu. 
*/
if DYNFUNremoveCivilViewFromMainMenu != undefined do (
  -- Unregister existing Civil View Main Menu
  local LOCcvMainMenuIndex = DYNFUNremoveCivilViewFromMainMenu()
    
  -- Register new Civil View Main Menu
  DYNFUNaddCivilViewtoMainMenu LOCcvMainMenuIndex:LOCcvMainMenuIndex
)
